# Exemplo de configuração de variáveis de ambiente (.env)
# Copie para .env (ou /data/local/tmp/suwayomi-proxy/.env no Android) e preencha conforme sua infraestrutura.

# --- Conexão SSH com a VPS ---
VPS_USER=usuario_ssh
VPS_HOST=10.0.0.1
VPS_SSH_KEY=/data/local/tmp/suwayomi-proxy/ssh-key.key
VPS_DOCKER_BRIDGE=172.19.0.1
VPS_TUNNEL_PORT=18192
VPS_WARP_IP=172.19.0.5
VPS_WARP_PORT=1080

# --- URLs e Configurações das Fontes Personalizadas (Opcional) ---
SOURCE_A_URL=https://exemplo-fonte-a.com
SOURCE_A_PATH_PREFIX=/dist/custom
SOURCE_A_XOR_KEY=CustomKey
SOURCE_B_URL=https://exemplo-fonte-b.com
PROXY_PORT=8192
